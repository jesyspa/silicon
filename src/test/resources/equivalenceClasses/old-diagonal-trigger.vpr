domain Equiv {
  function rel(Ref, Ref): Bool
  function diag(Ref): Bool
  axiom {
    forall x: Ref, y: Ref :: { rel(x,y) }
      (x == y ==> rel(x,y)) && (rel(x,y) == rel(y,x))
  }
  axiom {
    forall x: Ref, y: Ref, z: Ref :: { rel(x,y), rel(y,z) }
      rel(x,y) && rel(y,z) ==> rel(x,z)
  }
}
method diagonal(a: Ref)
  requires rel(a,a)
{
  // old(x) and x translate to the same bound variable, collapsing this pattern.
  inhale forall x: Ref :: { rel(x,old(x)) } diag(x)
  assert diag(a)
}
