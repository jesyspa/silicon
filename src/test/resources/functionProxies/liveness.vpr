field next: Ref
field value: Int
predicate list(x: Ref) { x != null ==> acc(x.next) && list(x.next) }
function plain(i: Int): Int { i + 1 }
function abstracted(i: Int): Int ensures result == i + 2
@opaque()
function hidden(i: Int): Int ensures result == i + 3 { i + 3 }
function numeric(i: Int): Int
  requires i >= 0
{ i == 0 ? 0 : numeric(i - 1) + 1 }
function length(x: Ref): Int
  requires list(x)
{ unfolding list(x) in x == null ? 0 : 1 + length(x.next) }
function fallback(x: Ref, y: Ref): Int
  requires list(x) && acc(y.value)
{ unfolding list(x) in x == null ? y.value : 1 + fallback(x.next, y) }
@opaque()
function hiddenLength(x: Ref): Int
  requires list(x)
{ unfolding list(x) in x == null ? 0 : 1 + hiddenLength(x.next) }
function useLength(x: Ref): Int
  requires list(x)
{ length(x) }
method valid(x: Ref, y: Ref)
  requires list(x) && acc(y.value)
{
  assert plain(4) == 5
  assert abstracted(4) == 6
  assert hidden(4) == 7
  assert numeric(0) == 0
  var n: Int := length(x)
  var m: Int := fallback(x, y)
  assert useLength(x) == n
  unfold list(x)
  if (x == null) {
    assert n == 0
    assert m == y.value
  } else {
    assert n == 1 + length(x.next)
    assert m == 1 + fallback(x.next, y)
  }
}
method invalidPlain() {
  assert plain(4) == 6
}
method invalidAbstract() {
  assert abstracted(4) == 7
}
method invalidHidden() {
  assert hidden(4) == 8
}
method invalidNumeric() {
  assert numeric(0) == 1
}
method invalidLength(x: Ref)
  requires list(x) && x == null
{
  assert length(x) == 1
}
method invalidFallback(x: Ref, y: Ref)
  requires list(x) && acc(y.value) && x == null
{
  assert fallback(x, y) == y.value + 1
}
