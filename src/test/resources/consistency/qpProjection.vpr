predicate P(x: Ref, i: Int, y: Ref) { true }

method projection(xs: Set[Ref], x: Ref)
  requires x in xs
{
  inhale forall r: Ref :: { r in xs } r in xs ==> acc(P(r, 5, r))
  assert acc(P(x, 5, x))
}

method groundArgument(xs: Set[Ref], x: Ref)
  requires x in xs
{
  inhale forall r: Ref :: { r in xs } r in xs ==> acc(P(r, 5, r))
  //:: ExpectedOutput(assert.failed:insufficient.permission)
  assert acc(P(x, 6, x))
}

method repeatedArgument(xs: Set[Ref], x: Ref, y: Ref)
  requires x in xs && x != y
{
  inhale forall r: Ref :: { r in xs } r in xs ==> acc(P(r, 5, r))
  //:: ExpectedOutput(assert.failed:insufficient.permission)
  assert acc(P(x, 5, y))
}
